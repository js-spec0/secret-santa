# Zkopíruj do .env.local a vyplň. Na Vercelu nastav stejné proměnné v Project → Settings → Environment Variables.

# Supabase → Project Settings → API (Data API URL) a API Keys (secret / service_role klíč).
# Klíč nikdy nedávej do kódu ani do proměnné s prefixem NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace SMTP. SMTP_PASSWORD je heslo aplikace (App Password), ne běžné heslo k účtu:
# https://myaccount.google.com/apppasswords (vyžaduje zapnuté dvoufázové ověření)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jmeno@domena.cz
SMTP_PASSWORD=
EMAIL_FROM="Secret Santa <jmeno@domena.cz>"

# Heslo do /admin a tajný klíč pro podpis admin cookie (aspoň 32 znaků).
# Vygeneruj např.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Veřejná adresa aplikace (pro odkazy v emailech). Na Vercelu ji lze vynechat,
# pak se použije produkční doména projektu.
APP_URL=http://localhost:3000
